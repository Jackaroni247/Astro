#include <Eigen/Dense>
#include <vector>
#include <cmath>

using namespace Eigen;

double getPhaseSpaceDistance(const CelestialObject& a, const CelestialObject& b) {
    return (a.GCCoords.PSVector-b.GCCoords.PSVector).norm();
}

//Defines the similarity function between 0-1
double getSimilarity(const CelestialObject& a, const CelestialObject& b) {
    return std::exp(-1.0 * std::pow(getPhaseSpaceDistance(a, b), 2));
}

// Creates the similarity matrix
MatrixXd similarityMatrix(std::vector<CelestialObject> dataVector) {
	int sizeT = dataVector.size();
	MatrixXd a(sizeT,sizeT);
    for(size_t i = 0; i < sizeT; i++) {
		for(size_t j = 0; j < sizeT; j++) {
			a(i,j) = getSimilarity(dataVector[i],dataVector[j]);
		}
    }
    return a;
}

// Normalize the rows of a matrix
void normalizeMatrix(MatrixXd& input) {
	input = input.cwiseQuotient(input.rowwise().norm());
}

MatrixXd degreeMatrix(const MatrixXd& similarityMatrix) {
    
}

MatrixXd laplacianMatrix(const MatrixXd& degreeMatrix, const MatrixXd& similarityMatrix) {
    return degreeMatrix - similarityMatrix;
}
